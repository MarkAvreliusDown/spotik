SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:43812/callback

# Локальный Ollama (https://ollama.com). По умолчанию — стандартный адрес
# после `ollama serve`/установки приложения и модель qwen2.5:7b (нужно
# заранее скачать: `ollama pull qwen2.5:7b`). Переопределять нужно, только
# если Ollama слушает нестандартный адрес или используется другая модель.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
