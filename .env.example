SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:43812/callback

# Локальный Ollama (https://ollama.com). По умолчанию — стандартный адрес
# после `ollama serve`/установки приложения и модель gemma2:9b (нужно
# заранее скачать: `ollama pull gemma2:9b`). Переопределять нужно, только
# если Ollama слушает нестандартный адрес или используется другая модель.
# Модели с большой долей китайских данных в претрейне (например, qwen2.5)
# иногда "соскальзывают" в китайский посреди строки — если решите
# использовать такую модель, см. компенсирующую логику в
# src/main/translation/ollamaClient.ts.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:9b
